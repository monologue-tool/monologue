[sub_resource type="GDScript" id="GDScript_6nrhx"]
script/source = "extends Node

const DIR := (
	\"C:/Users/holyt/AppData/Local/Temp/claude/\"
	+ \"C--Users-holyt-Documents-GitHub-Monologue--claude-worktrees-funny-elgamal-20298a/\"
	+ \"e4d7a8dd-42b2-40df-aeb7-5d9e3633d2c1/scratchpad/\"
)

const ROWS := [
	\"checked + enabled\",
	\"checked + DISABLED\",
	\"unchecked + enabled\",
	\"unchecked + DISABLED\",
	\"radio checked + enabled\",
	\"radio checked + DISABLED\",
	\"radio unchecked + enabled\",
	\"radio unchecked + DISABLED\",
]


func _ready() -> void:
	var before: Image = Image.load_from_file(DIR + \"before.png\")
	var after: Image = Image.load_from_file(DIR + \"after.png\")

	# Locate icon rows: scan the gutter column band and group rows that contain
	# non-background pixels.
	var bg: Color = after.get_pixelv(Vector2i(300, 300))
	var bands: Array = []
	var start: int = -1
	for y in range(24, 220):
		var lit: bool = false
		for x in range(38, 56):
			var c: Color = after.get_pixelv(Vector2i(x, y))
			if absf(c.r - bg.r) + absf(c.g - bg.g) + absf(c.b - bg.b) > 0.06:
				lit = true
				break
		if lit and start < 0:
			start = y
		elif not lit and start >= 0:
			bands.append([start, y - 1])
			start = -1
	if start >= 0:
		bands.append([start, 219])

	print(\"\\nfound %d icon bands\" % bands.size())
	print(\"%-28s %-22s %-22s %s\" % [\"row\", \"BEFORE (brightest)\", \"AFTER (brightest)\", \"changed\"])
	for i in bands.size():
		var y0: int = bands[i][0]
		var y1: int = bands[i][1]
		var b: Color = _brightest(before, y0, y1)
		var a: Color = _brightest(after, y0, y1)
		var label: String = ROWS[i] if i < ROWS.size() else \"band %d (y %d-%d)\" % [i, y0, y1]
		print(
			\"%-28s %-22s %-22s %s\"
			% [label, b.to_html(false), a.to_html(false), \"YES\" if b != a else \"no\"]
		)

	print(\"\\n-- pairwise identity within each render --\")
	_pair(before, after, bands, 0, 1, \"checked vs checked_disabled\")
	_pair(before, after, bands, 2, 3, \"unchecked vs unchecked_disabled\")
	_pair(before, after, bands, 4, 5, \"radio_checked vs radio_checked_disabled\")
	_pair(before, after, bands, 6, 7, \"radio_unchecked vs radio_unchecked_disabled\")

	get_tree().quit()


func _brightest(img: Image, y0: int, y1: int) -> Color:
	var best: Color = Color.BLACK
	for y in range(y0, y1 + 1):
		for x in range(38, 56):
			var c: Color = img.get_pixelv(Vector2i(x, y))
			if c.get_luminance() > best.get_luminance():
				best = c
	return best


func _pair(before: Image, after: Image, bands: Array, i: int, j: int, label: String) -> void:
	if i >= bands.size() or j >= bands.size():
		return
	var b_same: bool = _brightest(before, bands[i][0], bands[i][1]) == _brightest(
		before, bands[j][0], bands[j][1]
	)
	var a_same: bool = _brightest(after, bands[i][0], bands[i][1]) == _brightest(
		after, bands[j][0], bands[j][1]
	)
	print(
		\"%-45s before: %s   after: %s\"
		% [
			label,
			\"IDENTICAL\" if b_same else \"distinct\",
			\"IDENTICAL\" if a_same else \"distinct\"
		]
	)
"

